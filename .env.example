# Backend API base URL (no trailing slash).
VITE_API_URL=http://localhost:8000

# Google OAuth 2.0 Web client ID. The origin serving this app must be listed
# under "Authorised JavaScript origins" for that client, or sign-in silently
# fails with an origin_mismatch.
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Optional. Where takedown and correction requests go, shown in the footer
# disclaimer. Falls back to opening a GitHub issue on the backend repo, which
# keeps a personal mailbox off a public page.
# VITE_CONTACT_EMAIL=
