# =============================================================================
# Secrets — Vite inlines every VITE_* var into the client bundle, so a
# committed .env is a published .env. Keep this block first.
# =============================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
secrets/
.netrc
.npmrc
.yarnrc
.direnv/
.envrc

# =============================================================================
# Dependencies
# =============================================================================
node_modules/
.pnpm-store/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions
jspm_packages/
web_modules/
bower_components/

# =============================================================================
# Build output
# =============================================================================
dist/
dist-ssr/
build/
out/
.output/
.vercel/
.netlify/
storybook-static/

# Bundle analysis
stats.html
bundle-stats.json

# =============================================================================
# Caches
# =============================================================================
.vite/
vite.config.*.timestamp-*
.cache/
.parcel-cache/
.rollup.cache/
.turbo/
.eslintcache
.stylelintcache
.prettiercache
*.tsbuildinfo
tsconfig.tsbuildinfo
.npm/
.rpt2_cache/
.rts2_cache_*/

# =============================================================================
# Logs
# =============================================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.json

# =============================================================================
# Testing & coverage
# =============================================================================
coverage/
*.lcov
.nyc_output/
playwright-report/
playwright/.cache/
test-results/
blob-report/
__snapshots__/*.snap.new

# =============================================================================
# Local scratch
# =============================================================================
designs/
tmp/
temp/
*.bak
*.tmp
*.orig
*.rej
*.local

# =============================================================================
# Editors, IDEs, and local tool state
# =============================================================================
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
*.code-workspace
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# AI assistant local state (shared config stays tracked)
.claude/settings.local.json
.aider*
.cursorignore

# =============================================================================
# OS cruft
# =============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.fseventsd
.AppleDouble
.LSOverride
Icon?
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk
